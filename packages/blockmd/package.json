{
  "name": "@inka/blockmd",
  "version": "0.0.1",
  "private": true,
  "description": "blockmd: markdown <-> Plone block documents. slate-md, prototype-mapping and default-prototypes are plain JS; markdown-mount and restore-directives read from disk.",
  "exports": {
    "./default-prototypes.mjs": "./default-prototypes.mjs",
    "./markdown-mount.mjs": "./markdown-mount.mjs",
    "./prototype-mapping.mjs": "./prototype-mapping.mjs",
    "./restore-directives.mjs": "./restore-directives.mjs",
    "./slate-md.mjs": "./slate-md.mjs",
    "./slate-normalize.mjs": "./slate-normalize.mjs"
  },
  "dependencies": {
    "@adobe/remark-gridtables": "3.0.20",
    "@volto-hydra/helpers": "workspace:*",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-mdast": "10.1.2",
    "htmlparser2": "6.1.0",
    "ignore": "5.3.2",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.1.2",
    "remark-definition-list": "^2.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "yaml": "1.10.2"
  },
  "license": "MIT"
}
