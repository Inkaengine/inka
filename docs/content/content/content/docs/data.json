    "ul-7": {
      "@type": "slate",
      "plaintext": "Open user preferences (bottom-left). Pick one of the preset frontends, or paste in your own frontend URL. Edit any page — every change updates the live preview.",
      "value": [
        {
          "type": "ul",
          "children": [
            {
              "type": "li",
              "children": [
                {
                  "text": "Open user preferences (bottom-left)."
                }
              ]
            },
            {
              "type": "li",
              "children": [
                {
                  "text": "Pick one of the preset frontends, or paste in your own frontend URL."
                }
              ]
            },
            {
              "type": "li",
              "children": [
                {
                  "text": "Edit any page — every change updates the live preview."
                }
              ]
            }
          ]
        }
      ]
    },
    "p-8": {
      "@type": "slate",
      "plaintext": "The default preset is a Nuxt.js frontend deployed as an [SSG](https://hydra-nuxt-flowbrite.netlify.app/) to demonstrate scale-to-zero editing on free hosting. An [Astro example](https://github.com/collective/volto-hydra/tree/main/docs/examples/test-astro) demonstrates the [server-render pattern](./server-rendered-frontends.md) for static-first frameworks. See [Build a frontend › Deployment patterns](./build-a-frontend.md#deployment-patterns).",
      "value": [
        {
          "type": "p",
          "children": [
            {
              "text": "The default preset is a Nuxt.js frontend deployed as an "
