      "value": [
        {
          "type": "h2",
          "children": [
            {
              "text": "Try the online demo"
            }
          ]
        }
      ]
    },
    "p-5": {
      "@type": "slate",
      "plaintext": "The fastest way to feel what Inka does is to log into the hosted demo and edit a real page against a real frontend.",
      "value": [
        {
          "type": "p",
          "children": [
            {
              "text": "The fastest way to feel what Inka does is to log into the hosted demo and edit a real page against a real frontend."
            }
          ]
        }
      ]
    },
    "p-6": {
      "@type": "slate",
      "plaintext": "Open <https://hydra.pretagov.com>, log in, then:",
      "value": [
        {
          "type": "p",
          "children": [
            {
              "text": "Open <https://hydra.pretagov.com>, log in, then:"
