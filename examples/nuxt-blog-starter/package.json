{
  "name": "nuxt-blog-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-hydra": "pnpm -F @volto-hydra/hydra-js build && mkdir -p ./packages && cp ../../packages/hydra-js/hydra.js ./packages/hydra.js",
    "prebuild": "pnpm run sync-hydra",
    "build": "nuxt build",
    "predev": "pnpm run sync-hydra",
    "dev": "nuxt dev",
    "predev_edit": "pnpm run sync-hydra",
    "dev_edit": "nuxt dev --envName edit",
    "dev:test": "NUXT_PUBLIC_BACKEND_BASE_URL=http://localhost:${HYDRA_MOCK_API_PORT:-8888} NUXT_PUBLIC_ADMIN_URL=http://localhost:${HYDRA_VOLTO_SSR_PORT:-3001} nuxt dev --envName edit --port ${HYDRA_NUXT_PORT:-3003}",
    "build:test": "NUXT_TEST_BACKEND=http://localhost:8888 nuxt build --envName edit",
    "preview:test": "npx serve .output/public -s -l tcp://0.0.0.0:3003",
    "pregenerate": "pnpm run sync-hydra",
    "generate": "nuxt generate",
    "preedit": "pnpm run sync-hydra",
    "edit": "nuxt generate --envName edit",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@vueuse/core": "^11.3.0",
    "flowbite": "^2.5.2",
    "highlight.js": "^11.11.1",
    "netlify-cli": "^23.12.3",
    "nitropack": "^2.10.4",
    "nuxi": "^3.15.0",
    "nuxt": "^3.20.2",
    "nuxt-security": "^2.0.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.21",
    "vite-plugin-mkcert": "^1.17.6",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "tailwindcss": "^3.4.19"
  },
  "pnpm": {
    "overrides": {
      "sharp": "$sharp"
    }
  }
}
