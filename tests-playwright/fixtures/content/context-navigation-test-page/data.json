          "@type": "listing",
          "variation": "navItem",
          "fieldMapping": {
            "getURL": {
              "field": "href",
              "type": "link"
            },
            "title": {
              "field": "label",
              "type": "string"
            }
          },
          "querystring": {
            "query": [
              {
                "i": "path",
                "o": "plone.app.querystring.operation.string.absolutePath",
