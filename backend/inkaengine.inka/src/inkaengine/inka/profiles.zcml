<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="inkaengine.inka"
    >

  <genericsetup:registerProfile
      name="default"
      title="Inka: Install"
      description="Package to configure a new Inka site"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      post_handler=".upgrades.post_install"
      />

  <genericsetup:upgradeStep
      title="Add the Template type; templates pages use become Templates"
      profile="inkaengine.inka:default"
      source="1000"
      destination="1001"
      handler=".upgrades.to_1001"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Inka: Uninstall"
      description="Uninstall Inka setup."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <!-- Hide Uninstall Profile-->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="inkaengine.inka"
      />

</configure>
