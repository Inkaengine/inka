<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    >

  <!-- The inline `?expand=templates` path. -->
  <adapter
      factory=".get.Templates"
      name="templates"
      />

  <!-- The standalone route, served by the same adapter. -->
  <plone:service
      method="GET"
      for="zope.interface.Interface"
      factory=".get.TemplatesGet"
      name="@templates"
      permission="zope2.View"
      />

</configure>
