# Built bridge artifacts — source of truth is packages/hydra-js/hydra.src.js.
# Consumers either bundle from source via their build tool's alias, or import
# via the package's exports field which now points at the source.
packages/hydra-js/hydra.js
packages/hydra-js/hydra.js.map

# Generated screenshots and demo video — web-only artifacts, not version
# controlled. The capture specs regenerate them on demand and they are
# delivered to the Plone site directly, not through the committed docs.
docs/examples/_images/
*.mp4
*.webm

# blockmd prototype output — regenerate with `node proposals/blockmd/convert.mjs`
# and `node proposals/blockmd/export-tree.mjs`
proposals/blockmd/out/
proposals/blockmd/tree/
# Storage states are generated per-run from ports.ts (see global-setup)
tests-playwright/.generated/
.text-style-coverage/
# Generated Sphinx/myst source — `pnpm gen:myst` emits it OUTSIDE docs/ (the
# source tree stays loader-shaped <block> markdown); a throwaway build artifact.
_myst-build/

# WordPress plugins the contract suite mounts into Playground — fetched, not
# committed. Regenerate with `pnpm wp:plugins`.
tests-adapters/fixtures/wp-plugins/
# The Strapi instance the contract suite runs against — ~670MB of deps,
# scaffolded by `pnpm strapi:fixture`. The committed part is the content model
# in tests-adapters/fixtures/strapi-app/src.
tests-adapters/fixtures/strapi-app/app/

