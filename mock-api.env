# Inka's own content, and the block schemas of Inka's test frontend it is written
# for. The mock API reads this file from the directory it is started in, when
# CONTENT_MOUNTS isn't already set; paths are relative to that directory.
# Most specific mount first: '/' owns everything, so it goes last.
CONTENT_MOUNTS=/docs:docs,/_test_data:tests-playwright/fixtures/content,/:tests-playwright/fixtures/site-root
CONTENT_SCHEMAS=tests-playwright/fixtures/shared-block-schemas.js
